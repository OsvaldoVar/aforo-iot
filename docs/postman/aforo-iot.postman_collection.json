      "name": "API",
      "item": [
        {
          "name": "Estado de la API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código de estado 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Respuesta con success true y campos de diagnóstico', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.mensaje).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(json.servicio).to.eql('api_aforo');",
                  "    pm.expect(json.version).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(json.configurado).to.be.a('boolean');",
                  "    pm.expect(json.fecha_servidor).to.be.a('string').and.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/index.php",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "index.php"
              ]
            }
          }
        }
      ]
    },
