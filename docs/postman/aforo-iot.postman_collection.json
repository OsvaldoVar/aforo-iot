                  "const json = pm.response.json();",
                  "",
                  "pm.test('Estado del dispositivo con campos planos esperados', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.mensaje).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(json.dispositivo_id).to.eql(1);",
                  "    pm.expect(json.nombre_dispositivo).to.be.a('string').and.not.be.empty;",
                  "    pm.expect(json.dentro).to.be.a('number').and.be.at.least(0);",
                  "    pm.expect(json.aforo_max).to.satisfy(function (v) { return v === null || typeof v === 'number'; });",
                  "    pm.expect(json.en_linea).to.be.a('boolean');",
                  "    pm.expect(json.ultima_conexion).to.satisfy(function (v) { return v === null || typeof v === 'string'; });",
                  "    pm.expect(json.medicion).to.be.an('object');",
                  "    pm.expect(json.medicion.temperatura).to.be.a('number');",
                  "    pm.expect(json.medicion.humedad).to.be.a('number');",
                  "    pm.expect(json.medicion.fecha).to.be.a('string').and.not.be.empty;",
                  "});"
                ]
              }
